ls -l / | awk '{print $1}'
cat /etc/passwd | awk -F':' '{print $1, $4}'
ls -lh /
ls -l / | awk '{print "tamaño :"$5/1024 "KiB"}'
echo 3456 | awk '{print "tamaño :"$5/1024 "KiB"}'
echo 11 22 | awk  '{print $1 + $2}'
echo 11 22 | awk  '{print $1 $2}'
echo "hola mundo , que tal" | awk '{print $NF}'
echo "hola mundo , que tal" | awk '{print $0}'
echo "11 22 33 " | awk '{  tolat =0; for (i=1; i<=NF; i++) total += $i; print total}'
echo "11 22 33 " | awk '{  total =0; for (i=1; i<=NF; i++) total += $i; print total/NF}'
ls -l  / | awk 'BEGIN {print "tamaños de los archivos "}  {print $9, $5} END {print" fin de ls lista"}'
ls -l  / | awk 'BEGIN {print "tamaños de los archivos "}  {print $9, $5; total += $5} END {print" fin de ls lista, suma total: " total}'
ls -l  / | awk 'BEGIN {print "tamaños de los archivos "}  {print $9, $5; total += $5; n++} END {print" fin de ls lista, suma total: " total/n}'
awk '{i=0; while (i<10) print i; i++;}'
awk 'BEGIN { i=0; while (i < 10) { print i; i++ } }'
